@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@GRAPHOS_ENABLE_RAJA@)
  find_dependency(RAJA)
endif()
if(@GRAPHOS_ENABLE_UMPIRE@)
  find_dependency(umpire)
endif()
if(@GRAPHOS_ENABLE_CHAI@)
  find_dependency(chai)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/graphosTargets.cmake")
check_required_components(graphos)
